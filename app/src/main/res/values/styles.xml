<resources>
    <style name="BaseAppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:fontFamily">@font/vazirmatn</item>
        <item name="fontFamily">@font/vazirmatn</item>
        <item name="colorPrimary">@color/whitedns_primary</item>
        <item name="colorOnPrimary">@color/whitedns_on_primary</item>
        <item name="colorPrimaryContainer">@color/whitedns_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/whitedns_on_primary_container</item>
        <item name="colorSecondary">@color/whitedns_secondary</item>
        <item name="colorSurface">@color/whitedns_surface</item>
        <item name="colorSurfaceVariant">@color/whitedns_surface_variant</item>
        <item name="colorOnSurface">@color/whitedns_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/whitedns_on_surface_variant</item>
        <item name="colorOutline">@color/whitedns_outline</item>
        <item name="colorError">@color/whitedns_error</item>
        <item name="android:windowBackground">@color/whitedns_background</item>
        <item name="android:statusBarColor">@color/whitedns_background</item>
        <item name="android:navigationBarColor">@color/whitedns_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:colorAccent">@color/whitedns_primary</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="tabStyle">@style/WhiteDnsTabLayout</item>
        <item name="switchStyle">@style/Widget.WhiteDns.Switch</item>
            <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.WhiteDns</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.WhiteDns.Large</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.WhiteDns.Large</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.WhiteDns.Dialog</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.WhiteDns.Dialog</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.WhiteDns.BottomSheet</item>
</style>

    <style name="WhiteDnsTabTextAppearance" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:fontFamily">@font/vazirmatn</item>
        <item name="fontFamily">@font/vazirmatn</item>
    </style>

    <style name="WhiteDnsTabLayout" parent="Widget.Material3.TabLayout">
        <item name="tabTextAppearance">@style/WhiteDnsTabTextAppearance</item>
    </style>

    <style name="WhiteDnsPopupMenu" parent="Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">@color/whitedns_surface</item>
    </style>

    <style name="WhiteDnsPopupTheme" parent="ThemeOverlay.AppCompat">
        <item name="android:fontFamily">@font/vazirmatn</item>
        <item name="fontFamily">@font/vazirmatn</item>
        <item name="colorAccent">@color/whitedns_primary</item>
        <item name="colorControlHighlight">@color/whitedns_primary_container</item>
        <item name="colorControlNormal">@color/whitedns_on_surface_variant</item>
        <item name="popupMenuStyle">@style/WhiteDnsPopupMenu</item>
    </style>

    <style name="AppTheme" parent="BaseAppTheme" />

    <!-- ЕДИНЫЕ ЗАКРУГЛЕНИЯ ВО ВСЁМ ПРИЛОЖЕНИИ -->
    <style name="ShapeAppearance.WhiteDns" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">22dp</item>
        <item name="cornerSizeTopRight">22dp</item>
        <item name="cornerSizeBottomLeft">22dp</item>
        <item name="cornerSizeBottomRight">22dp</item>
    </style>
    <style name="ShapeAppearance.WhiteDns.Large" parent="ShapeAppearance.WhiteDns">
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomLeft">28dp</item>
        <item name="cornerSizeBottomRight">28dp</item>
    </style>
    <style name="ShapeAppearance.WhiteDns.Dialog" parent="ShapeAppearance.WhiteDns.Large" />

    <!-- ДИАЛОГИ: цвет и закругления -->
    <style name="ThemeOverlay.WhiteDns.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/whitedns_surface</item>
        <item name="colorOnSurface">@color/whitedns_on_surface</item>
        <item name="colorPrimary">@color/whitedns_primary</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.WhiteDns.Dialog</item>
        <item name="dialogCornerRadius">28dp</item>
    </style>
    <style name="Widget.WhiteDns.Switch" parent="Widget.Material3.CompoundButton.Switch">
        <item name="trackCornerRadius">14dp</item>
        <item name="thumbWidth">24dp</item>
        <item name="thumbHeight">24dp</item>
        <item name="colorPrimary">@color/whitedns_primary</item>
        <item name="android:colorPrimary">@color/whitedns_primary</item>
    </style>
</resources>
