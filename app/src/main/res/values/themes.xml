<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.MyApplication" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/whitedns_primary</item>
        <item name="colorOnPrimary">@color/whitedns_on_primary</item>
        <item name="colorPrimaryContainer">@color/whitedns_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/whitedns_on_primary_container</item>
        <item name="colorSecondary">@color/whitedns_secondary</item>
        <item name="colorSurface">@color/whitedns_surface</item>
        <item name="colorSurfaceVariant">@color/whitedns_surface_variant</item>
        <item name="colorOnSurface">@color/whitedns_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/whitedns_on_surface_variant</item>
        <item name="colorOutline">@color/whitedns_outline</item>
        <item name="colorError">@color/whitedns_error</item>
        <item name="android:windowBackground">@color/whitedns_background</item>
        <item name="android:statusBarColor">@color/whitedns_background</item>
        <item name="android:navigationBarColor">@color/whitedns_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
    <style name="ThemeOverlay.WhiteDns.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.WhiteDns.BottomSheet</item>
    </style>
    <style name="Widget.WhiteDns.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="shapeAppearance">@style/ShapeAppearance.WhiteDns.Large</item>
        <item name="backgroundTint">@color/whitedns_surface</item>
    </style>
</resources>
